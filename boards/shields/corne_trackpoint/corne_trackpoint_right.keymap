#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/ext_power.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            bindings = <
    &trans &trans &trans &trans &trans &trans   &kp Y &kp U   &kp I   &kp O     &kp P     &kp BSPC
    &trans &trans &trans &trans &trans &trans       &kp H &kp J   &bt BT_CLR   &kp L     &kp SEMI  &kp RET
    &trans &trans &trans &trans &trans &trans   &kp N &kp M   &kp COMMA &ext_power EP_TOG  &kp FSLH  &kp RSHFT
    &trans &trans &trans &trans &trans &trans   &kp SPACE &mo 1  &kp RET  &kp ESC  &kp TAB   &kp DEL
            >;
        };

        lower_layer {
            display-name = "LOWER";
            bindings = <
    &trans &trans &trans &trans &trans &trans   &kp F1 &kp F2  &kp F3  &kp F4  &kp F5  &kp F6
    &trans &trans &trans &trans &trans &trans   &kp F7 &kp F8  &kp F9  &kp F10 &kp F11 &kp F12
    &trans &trans &trans &trans &trans &trans   &bt BT_CLR &trans &trans &trans &trans &trans
    &trans &trans &trans &trans &trans &trans   &kp SPACE &mo 1 &kp RET &kp ESC &kp TAB &kp DEL
            >;
        };

        tp_layer {
            display-name = "TP";
            bindings = <
    &trans &trans &trans &trans &trans &trans   &kp Y &kp U   &kp I   &kp O     &kp P     &kp BSPC
    &trans &trans &trans &trans &trans &trans   &kp H &kp J   &kp K   &kp L     &kp SEMI  &kp RET
    &trans &trans &trans &trans &trans &trans   &kp N &kp M   &kp COMMA &ext_power EP_TOG  &kp FSLH  &kp RSHFT
    &trans &trans &trans &trans &trans &trans   &kp SPACE &trans &kp RET &kp ESC  &kp TAB   &kp DEL
            >;
        };
    };
};
