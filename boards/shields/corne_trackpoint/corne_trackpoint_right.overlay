#include "corne_trackpoint.dtsi"

&pinctrl {
    i2c0_default: i2c0_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 17)>,
                    <NRF_PSEL(TWIM_SCL, 0, 20)>;
        };
    };
    i2c0_sleep: i2c0_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 17)>,
                    <NRF_PSEL(TWIM_SCL, 0, 20)>;
            low-power-enable;
        };
    };
};

&i2c0 {
    status = "disabled";
};

/* Exp44: the ATtiny85 USI slave cannot keep up with the nRF TWIM's byte
 * timing (it cannot clock-stretch). Use a bit-banged GPIO I2C bus at 20kHz
 * instead — software timing gives the USI all the inter-byte gaps it needs. */
/ {
    i2c_trackball: i2c-gpio-trackball {
        compatible = "gpio-i2c";
        status = "okay";
        sda-gpios = <&gpio0 17 (GPIO_OPEN_DRAIN | GPIO_PULL_UP)>;
        scl-gpios = <&gpio0 20 (GPIO_OPEN_DRAIN | GPIO_PULL_UP)>;
        clock-frequency = <20000>;
        #address-cells = <1>;
        #size-cells = <0>;

        trackball: trackball@42 {
            compatible = "promini,trackpoint-i2c";
            status = "okay";
            reg = <0x42>;
            irq-gpios = <&gpio0 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
            reset-gpios = <&gpio0 8 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        };
    };
};

#if defined(CONFIG_ZMK_SPLIT_ROLE_PERIPHERAL) && CONFIG_ZMK_SPLIT_ROLE_PERIPHERAL
/* Peripheral: split forwards trackball data to dongle */
&trackball_split {
    device = <&trackball>;
};
&trackball_listener {
    status = "okay";
};
#else
/* Central / standalone (no split): listener reads trackball directly + layer-toggle */
/ {
    temp_layer: temp_layer {
        compatible = "zmk,input-processor-temp-layer";
        #input-processor-cells = <2>;
        status = "okay";
    };
};

&trackball_listener {
    device = <&trackball>;
    input-processors = <&temp_layer 2 2000>;
    status = "okay";
};
#endif

&default_transform {
    col-offset = <6>;
};

&physical_layout0 {
    kscan = <&kscan0>;
};

/ {
    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;
        row-gpios
            = <&gpio0 31 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 24 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 6  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
        col-gpios
            = <&gpio0 2  GPIO_ACTIVE_HIGH>
            , <&gpio0 29 GPIO_ACTIVE_HIGH>
            , <&gpio0 9  GPIO_ACTIVE_HIGH>
            , <&gpio1 0  GPIO_ACTIVE_HIGH>
            , <&gpio1 4  GPIO_ACTIVE_HIGH>
            , <&gpio1 11 GPIO_ACTIVE_HIGH>
            ;
    };
};
